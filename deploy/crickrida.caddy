crickrida.com {
	encode zstd gzip

	# Permanent redirects for retired addresses; the file is generated by the archive build (tools/build_site.py)
	# and copied here, and is written next to this file by domain.yml.
	import crickrida-redirects.caddy


	# The app, its files and its API run in the ipl-analytics container. llms.txt is the archive's:
	# its build writes one for the whole site (tools/ai_surface.py), with llms-full.txt and the feed.
	@app path /api/* /app/* /ipl /ipl/* /t20-world-cup /t20-world-cup/* /sw.js /sitemap-ipl.xml
	handle @app {
		reverse_proxy 127.0.0.1:8000
	}

	# Addresses the app used before it moved under /ipl and /t20-world-cup.
	# They never end in a slash or a file extension; the archive's pages and files do
	# (index.md is the Markdown copy the archive writes beside a page).
	@legacy {
		path_regexp ^/(dashboard|batting|bowling|venues|seasons|h2h|charts|pulse|matchups|phases|content-studio|fantasy|quiz|faq|image-credits|privacy|terms|account-deletion|admin|login|social|ask|player-impact)(/[^/]+)*$|^/(matches|teams|players)(/[^/]+)+$
		not path *.json *.xml *.txt *.md *.csv *.png *.svg *.webp *.jpg *.ico *.js *.css *.html *.parquet *.woff2
	}
	handle @legacy {
		reverse_proxy 127.0.0.1:8000
	}

	# The analytics lake for Studio and the tools, served from this domain so the browser needs no CORS.
	handle_path /lake/* {
		reverse_proxy https://pub-2deb6471d5df4274810ac4497fdf3ab2.r2.dev {
			header_up Host pub-2deb6471d5df4274810ac4497fdf3ab2.r2.dev
		}
	}

	# Everything else is the archive, mirrored onto this server from each audited release
	# by the crickrida-site-sync timer.
	handle {
		root * /srv/crickrida/site
		@versioned query v=*
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "public, max-age=300"
		@manifest path *.webmanifest
		header @manifest Content-Type application/manifest+json
		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		@feed path /feed.xml
		header @feed Content-Type "application/atom+xml; charset=utf-8"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			root * /srv/crickrida/site
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}

crickrida.rkjat.in {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
}

www.crickrida.com {
	redir https://crickrida.com{uri} permanent
}
