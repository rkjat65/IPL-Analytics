# ── Required ──────────────────────────────────────────────
# Google OAuth Client ID (for Sign in with Google). The backend checks Google
# tokens against GOOGLE_CLIENT_ID; if unset, tokens from any client are accepted.
GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# DuckDB file for analytics (Dashboard, Matches, etc.). On Oracle Docker use the same path as in docker-compose, e.g. /data/ipl.duckdb
# DUCKDB_PATH=/data/ipl.duckdb

# ── Optional ──────────────────────────────────────────────
# CORS origins (comma-separated, defaults to localhost)
# CORS_ORIGINS=https://your-app.railway.app,http://localhost:5173

# Password-reset email. Without SMTP, production returns the same generic
# response but does not expose a token. Set EXPOSE_RESET_TOKEN=true only for
# local development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Crickrida <no-reply@crickrida.rkjat.in>
# PUBLIC_APP_URL=https://crickrida.com
# CANONICAL_ORIGIN=https://crickrida.com
# EXPOSE_RESET_TOKEN=false

# Admin account email. Admin access also requires the email to be verified
# (Google sign-in or a completed password reset).
# ADMIN_EMAIL=you@example.com

# Twitter/X API (for Social Posting)
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
